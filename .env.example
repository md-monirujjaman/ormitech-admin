# OrmiTech Admin — environment variables
# Copy to .env.local for local development.
#
# IMPORTANT: Vite exposes every VITE_* variable to the browser bundle. Never put secrets, API keys,
# database credentials or admin tokens in a VITE_* variable — this app only ever holds public URLs.
# All real authentication/authorization happens on ormitech-api; nothing here is trusted for security.

# Base URL of the OrmiTech API. Every request in src/api/ is built from this.
VITE_API_URL=http://localhost:4000

# Related OrmiTech apps, linked from the admin UI (e.g. "view in dashboard" / "view live docs").
VITE_CLIENT_URL=https://ormitech-client.monirujjaman.me
VITE_DOCS_URL=https://ormitech-docs.monirujjaman.me
VITE_WEB_URL=https://ormitech-web.monirujjaman.me

# Which data source backs the admin screens.
#   mock — in-memory fixtures (default; ormitech-api's admin endpoints don't exist yet)
#   api  — real HTTP against VITE_API_URL; requests fail until those endpoints are built
VITE_ADMIN_DATA_SOURCE=mock
