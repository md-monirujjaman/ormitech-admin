# OrmiTech Admin — environment variables
# Copy to .env.local for local development.
#
# IMPORTANT: Vite exposes every VITE_* variable to the browser bundle. Never put secrets, API keys,
# database credentials or admin tokens in a VITE_* variable — this app only ever holds public URLs.
# All real authentication/authorization happens on ormitech-api; nothing here is trusted for security.

# Base URL of the OrmiTech API. Every request in src/api/ is built from this.
# Production: https://api.ormitechit.com
VITE_API_URL=http://localhost:4000

# Related OrmiTech apps, linked from the admin UI (e.g. "view in dashboard" / "view live docs").
VITE_CLIENT_URL=https://app.ormitechit.com
VITE_DOCS_URL=https://docs.ormitechit.com
VITE_WEB_URL=https://www.ormitechit.com

# Which data source backs the admin screens.
#   mock — in-memory fixtures (the default)
#   api  — real HTTP against VITE_API_URL. Needs POSTGRES_ADMIN_URL set on the API and an administrator
#          seeded; screens with no endpoint behind them (dashboard charts, notifications) say so.
VITE_ADMIN_DATA_SOURCE=mock

# Cloudflare Turnstile site key for the admin sign-in page (public by design; the secret key lives only in
# ormitech-api). Vite only exposes VITE_* variables, so this is the VITE_ form of CLOUDFLARE_TURNSTILE_SITE_KEY.
# REQUIRED: without it the sign-in page shows a configuration error and Sign in stays disabled.
# For local development, Cloudflare publishes a test key that always passes: 1x00000000000000000000AA
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
